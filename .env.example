# Copy this file to .env and fill it in. .env is git-ignored: never share it.

# Alpaca PAPER keys: https://app.alpaca.markets -> switch to Paper -> API Keys -> Generate
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
# Keep true for the contest. Real money needs ALPACA_PAPER=false AND `--real-money`.
ALPACA_PAPER=true

# Optional phone alerts: install the ntfy app, subscribe to a long random topic name, put it here.
NTFY_TOPIC=

# Optional: where data/records/state live (default: ./data)
# DASHCOUNT_DATA=
